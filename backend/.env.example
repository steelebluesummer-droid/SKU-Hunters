# LLM 供应商配置（全部 OpenAI 兼容格式，换供应商只改这两个变量）
# zhipu      智谱 GLM-4-Flash    永久免费无上限，开发期主力
# volcengine 火山引擎·豆包        新用户免费额度，演示期主力（贴赛题）
# deepseek   DeepSeek V4 Flash   永久免费
# dashscope  通义千问             每日免费调用额度
# moonshot   Kimi K3             审美/文案向增强

LLM_PROVIDER=deepseek
LLM_API_KEY=
# 可选覆盖默认值：
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_MAX_PROMPT_CHARS=12000   # user prompt 总量保险丝（超限取首尾截中段）

# 真 Agent 开关（不设则默认 mock，离线/确定/快；real 时数据/LLM 故障自动回退 mock）
# 总开关一行全开六官：
# AGENT_PROVIDER=real
# 分开关（优先级高于总开关，用于单点排障）：
# TREND_AGENT_PROVIDER=real
# USER_AGENT_PROVIDER=real
# IP_AGENT_PROVIDER=real
# CREATIVE_AGENT_PROVIDER=real
# BUSINESS_AGENT_PROVIDER=real
# GTM_AGENT_PROVIDER=real
# 注意：注册表在进程启动时求值，env 须在启动前设置

# 飞书集成（Phase 2）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 即梦图像生成（火山引擎视觉服务，AK/SK 签名调用）
VOLC_ACCESS_KEY_ID=
VOLC_SECRET_ACCESS_KEY=

# 企划资产库（多维表格）归档同步目标
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=

# Aily 发起企划后的结果通知群（机会卡推送目标）
FEISHU_NOTIFY_CHAT_ID=
# 前端地址（飞书卡片跳转链接用）
FRONTEND_BASE_URL=http://localhost:5173
