# LLM 供应商配置（全部 OpenAI 兼容格式，换供应商只改这两个变量）

LLM_PROVIDER=deepseek
LLM_API_KEY=
# 可选覆盖默认值：
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_MAX_PROMPT_CHARS=12000   # user prompt 总量保险丝（超限取首尾截中段）

# ═══ Strict Real Mode（生产环境，禁止 Mock）═══
# APP_ENV=production 且 ALLOW_MOCK=false → 严格真实模式：
#   · LLM / 数据源失败 → 阻断（抛错），不回退 MockAgent
#   · 真实数据不足 → unavailable（合法契约态），不用演示内容填满页面
#   · 禁止创建/打开 fixture 与 demo 任务；企划默认模式强制 live
#   · 健康检查 /health 返回 mock_allowed=false, strict_real=true
# 生产配置示例：
# APP_ENV=production
# ALLOW_MOCK=false
# BASE_PROVIDER_MODE=feishu
# PLANNING_DEFAULT_MODE=live
# AGENT_PROVIDER=real
# LEARNING_AGENT_PROVIDER=real
# 非生产（测试/开发）默认允许 Mock：APP_ENV 留空即可

# 真 Agent 开关（开发/测试默认 mock，离线/确定/快；real 时数据/LLM 故障回退 mock）
# 注意：严格模式（production + ALLOW_MOCK=false）下必须 real，否则启动即阻断
# 总开关一行全开六官：
# AGENT_PROVIDER=real
# 分开关（优先级高于总开关，用于单点排障）：
# TREND_AGENT_PROVIDER=real
# USER_AGENT_PROVIDER=real
# IP_AGENT_PROVIDER=real
# CREATIVE_AGENT_PROVIDER=real
# BUSINESS_AGENT_PROVIDER=real
# GTM_AGENT_PROVIDER=real
# 学习官独立开关（总开关不覆盖，需单独设）：
# LEARNING_AGENT_PROVIDER=real
# 注意：注册表在进程启动时求值，env 须在启动前设置

# 飞书集成（Phase 2）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 飞书 Base 数据表（SKU-Hunters 采集数据，只从环境变量读取，不硬编码）
# FEISHU_BASE_APP_TOKEN=       # 多维表格 ID（bitable app_token）
# FEISHU_DATA_TABLE_ID=        # 明细表 base_records
# FEISHU_SUMMARY_TABLE_ID=     # 汇总表 base_summaries
# FEISHU_COMPETITOR_TABLE_ID=  # 商品级竞品表 base_competitors（可选；缺失时竞品读取 fail-closed 降级）
# FEISHU_SNAPSHOT_TTL_SECONDS=3600  # 飞书快照本地缓存 TTL（秒，默认 3600）；过期重新访问飞书，非法值回退安全默认

# 即梦图像生成（火山引擎视觉服务，AK/SK 签名调用）
VOLC_ACCESS_KEY_ID=
VOLC_SECRET_ACCESS_KEY=
# JIMENG_REQ_KEY=jimeng_t2i_v40  # 即梦模型 req_key（默认 jimeng_t2i_v40，即梦图片生成 4.0）
# JIMENG_TIMEOUT=60              # 即梦轮询总超时秒数（默认 60）

# 企划资产库（多维表格）归档同步目标
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=

# Aily 发起企划后的结果通知群（机会卡推送目标）
FEISHU_NOTIFY_CHAT_ID=
# 前端地址（飞书卡片跳转链接用）
FRONTEND_BASE_URL=http://localhost:5173
# 跨域白名单（逗号分隔完整 origin；留空用默认；不允许 '*'，与 allow_credentials=True 冲突）
# CORS_ALLOW_ORIGINS=http://localhost:5173
# 单次 LLM 超时（秒，默认 45）；网络层重试次数（默认 1，即最多调用 2 次）
LLM_TIMEOUT=45
LLM_MAX_RETRIES=1
# FEISHU_IP_PARTNERSHIP_TABLE_ID=  # IP 合作情报表 base_ip_partnerships（IP 资源库扩充；缺失时 seed 33 条降级）
