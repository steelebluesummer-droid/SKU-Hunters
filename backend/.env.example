# LLM 供应商配置（全部 OpenAI 兼容格式，换供应商只改这两个变量）
# zhipu      智谱 GLM-4-Flash    永久免费无上限，开发期主力
# volcengine 火山引擎·豆包        新用户免费额度，演示期主力（贴赛题）
# deepseek   DeepSeek V4 Flash   永久免费
# dashscope  通义千问             每日免费调用额度
# moonshot   Kimi K3             审美/文案向增强

LLM_PROVIDER=deepseek
LLM_API_KEY=
# 可选覆盖默认值：
# LLM_BASE_URL=
# LLM_MODEL=

# 真 Agent 开关（不设则默认 mock，离线/确定/快；real 时 LLM 故障自动回退 mock）
# CREATIVE_AGENT_PROVIDER=real
# TREND_AGENT_PROVIDER=real

# 飞书集成（Phase 2）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 即梦图像生成（火山引擎视觉服务，AK/SK 签名调用）
VOLC_ACCESS_KEY_ID=
VOLC_SECRET_ACCESS_KEY=
